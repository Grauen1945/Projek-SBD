SELECT *, 
CASE WHEN (CPM1 < CPM2 AND CPM2 < CPM3 AND CPM3 < CPM4 AND CPM4 < CPM5 AND CPM5 < FINAL_PROJECT) THEN 'Konsisten Naik' 
    WHEN (CPM1 > CPM2 AND CPM2 > CPM3 AND CPM3 > CPM4 AND CPM4 > CPM5 AND CPM5 > FINAL_PROJECT) THEN 'Konsisten Turun'
    ELSE 'Fluktuatif' 
END AS Kategori_Nilai FROM hasil_studiLIMIT 40 OFFSET 60;